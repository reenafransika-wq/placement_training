import java.util.Scanner;
class sample {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int a = scan.nextInt();
        if(a % 2 == 0) {
            System.out.println("The given number is even");
        }
        else {
            System.out.println("The given number is odd");
        }
    }
}
