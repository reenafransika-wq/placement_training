import java.util.Scanner;
class sample1 {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int a = scan.nextInt();
        if(a > 0) {
            System.out.println("Positive number");
        }
        else if(a < 0) {
            System.out.println("Negative number");
        }
        else if( a == 0) {
            System.out.println("Zero");
        }
    }
}
